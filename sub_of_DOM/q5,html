<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Q5 - Image Gallery</title>
  <style>
    body { font-family: Arial, sans-serif; margin: 30px; }
    #gallery { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; max-width: 600px; }
    #gallery img { width: 100%; height: 140px; object-fit: cover; cursor: pointer; border-radius: 4px; }

    #modal { display: none; position: fixed; inset: 0; background: rgba(0, 0, 0, 0.75);
             justify-content: center; align-items: center; }
    #modal.open { display: flex; }
    #modalContent { background: #fff; padding: 10px; border-radius: 6px; max-width: 90%; }
    #modalImage { display: block; max-width: 100%; max-height: 80vh; }
  </style>
</head>
<body>
  <h2>Image Gallery</h2>
  <!-- data-full holds the bigger version of each image -->
  <div id="gallery">
    <img src="https://picsum.photos/id/10/300/200" data-full="https://picsum.photos/id/10/900/600" alt="Forest">
    <img src="https://picsum.photos/id/20/300/200" data-full="https://picsum.photos/id/20/900/600" alt="Desk">
    <img src="https://picsum.photos/id/30/300/200" data-full="https://picsum.photos/id/30/900/600" alt="Mug">
    <img src="https://picsum.photos/id/40/300/200" data-full="https://picsum.photos/id/40/900/600" alt="Cat">
    <img src="https://picsum.photos/id/50/300/200" data-full="https://picsum.photos/id/50/900/600" alt="Lake">
    <img src="https://picsum.photos/id/60/300/200" data-full="https://picsum.photos/id/60/900/600" alt="Office">
  </div>

  <div id="modal">
    <div id="modalContent">
      <img id="modalImage" src="" alt="">
    </div>
  </div>
  <script src="q5.js"></script>
</body>
</html>